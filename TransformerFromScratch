    "### Using the same previous architecture just with modifications for single head of self head attention\n",
    "torch.manual_seed(2506)\n",
    "x.shape #torch.Size([4, 12, 5]) \n",
    "# Now let say we wre changing the number of channels or words defining other token as n_embd=32\n",
    "B, T, C = 4,12,32 # No of batches: 4 || No. of tokens per bath (Context Window): 12 || No. of dimensions per token: 32\n",
    "x=torch.randn(B,T,C)\n",
    "\n",
    "# What is a head ? It is a learnable layer that acts as a communication channel. It processes input data through matrix multiplications to determine how much information each token in a sequence should \"pay attention\" to from other tokens in that same sequence.\n",
    "\n",
    "head_size=16 # 16 is chosen as it is the half of the n_embd so that this is efficient for now and can be scaled later for Multi-head Attention\n",
    "key=nn.Linear(C,head_size, bias=False)\n",
    "query=nn.Linear(C,head_size, bias=False)\n",
    "value=nn.Linear(C,head_size, bias=False)\n",
    "\n",
    "k=key(x)   # (4, 12, 16) Mapping our key, query and value vector to x data\n",
    "q=query(x) # (4, 12, 16)\n",
    "v=value(x) # (4, 12, 16)\n",
    "\n",
    "## SCALED DOT PROD\n",
    "\n",
    "# By far no communication, just we created the veectors and mapped it with our input but still the key and query are isolated, for communication we do dot prod\n",
    "weights = k @ q.transpose(-2,-1) * head_size**-0.5 #we did transpose the query mat since we know mat mul occurs as y=x(wT) # (4, 12, 16) @ (4 , 16, 16) ------> (4, 16, 16)\n",
    "print(\"Self Attended Weights: \\n\",weights)\n",
    "tril=torch.tril(torch.ones(T,T)) # tril if a lower triangular mask that will be used to fill the actual weights with affinity values from previous timestep and negative inf from future timesteps\n",
    "# weights= torch.zeros((T,T)) Not needed anymore \n",
    "weights = weights.masked_fill(tril==0, float('-inf')) # masking nob future timesteps gets innvolved\n",
    "weights=f.softmax(weights, dim=-1) #normalizing the output\n",
    "print(\"Softmaxed Weights: \\n\",weights)\n",
    "\n",
    "# Aggregation step\n",
    "# out = weights @ x We don't directly aggregate x now, rather,\n",
    "out = weights @ v\n",
    "out.shape"
   ]
