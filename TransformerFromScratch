    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.nn import functional as f\n",
    "\n",
    "torch.manual_seed(2506)\n",
    "\n",
    "class BigramModel(nn.Module):\n",
    "\n",
    "    def __init__(self, vocab_size):\n",
    "        super().__init__()# we are calling the parent class constructor from nn.Module as the constructor in our custom child class of BigramModel\n",
    "        self.token_embedding_table = nn.Embedding(vocab_size, vocab_size) \n",
    "        #creates an embedding table that correlates every tokens against other to give a probabilistic score or logit for the next predicted word\n",
    "\n",
    "    def forward(self, idx, target=None):\n",
    "        # idx and targets are both (b,t) tensor of integers - [tensor]bxt\n",
    "        logits=self.token_embedding_table(idx)\n",
    "        #loss=f.cross_entropy(logits, target) # But cross_entropy expects formatted batches, tensors, channels - therefore we need to format our logits and targets\n",
    "        \n",
    "        if target is None:\n",
    "            loss=None\n",
    "        else:\n",
    "            B, T, C = logits.shape\n",
    "            logits=logits.view(B*T, C)\n",
    "            targets=target.view(B*T)\n",
    "            loss=f.cross_entropy(logits, targets)\n",
    "        return logits, loss\n",
    "\n",
    "    def generate(self, idx, max_new_tokens):\n",
    "        #The transformer is also responsible for generating the very next words in a certain (batch and time ) from the logits and so on\n",
    "        for _ in range(max_new_tokens): # the generation should go on upto a certain token range\n",
    "            logits, loss=self(idx) # we first compute the logits from the Embeddings lookup table\n",
    "            logits=logits[:,-1] # we are just interested in generating the last tokens or predictions for the next word \n",
    "            prob_scores=f.softmax(logits, dim=-1) # we calculate probabilistic scores using softmax for the last layer\n",
    "            # sample from distribution\n",
    "            idx_next=torch.multinomial(prob_scores, num_samples=1)\n",
    "            idx=torch.cat((idx, idx_next), dim =1) # concatenate each newly predicted word to the main context\n",
    "        return idx\n",
    "\n",
